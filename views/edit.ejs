<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Post</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>
<body>

<nav class="navbar navbar-dark">
    <div class="container">
        <a href="/posts" class="navbar-brand">
             Threads
        </a>
    </div>
</nav>

<div class="container">

    <div class="compose-card">

        <h2 class="mb-4">
            Edit Thread
        </h2>

        <form
            action="/posts/<%= post.id %>?_method=PATCH"
            method="POST"
        >

            <div class="mb-3">

                <input
                    type="text"
                    class="form-control"
                    value="@<%= post.username %>"
                    
                >

            </div>

            <div class="mb-4">

                <textarea
                    name="content"
                    rows="6"
                    class="form-control"
                    required
                ><%= post.content %></textarea>

            </div>

            <div class="d-flex justify-content-between">

                <a href="/posts"
                   class="btn btn-outline-light">
                    Cancel
                </a>

                <button
                    class="btn btn-light">
                    Update Post
                </button>

            </div>

        </form>

    </div>

</div>

</body>
</html>