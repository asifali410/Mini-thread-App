    <div class="container mt-4">
  <h2>Create Post</h2>

  <form action="/posts" method="POST">
    <div class="mb-3">
      <label class="form-label">Username</label>
      <input
        type="text"
        name="username"
        class="form-control"
      >
    </div>

    <div class="mb-3">
      <label class="form-label">Content</label>
      <textarea
        name="content"
        class="form-control"
        rows="4"
      ></textarea>
    </div>

    <button class="btn btn-success">
      Create Post
    </button>
  </form>
</div>
</body>
</html>